# ==============================================================================
# Crypto Forex Predictor - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` and fill in your actual values:
#   copy .env.example .env

# Google Gemini API Key for Multimodal AI Signal Parser (Fast & accurate chart/text parsing)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MetaTrader 5 (MT5) Account Credentials (Optional - can also be configured directly in UI)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
